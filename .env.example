# Salin ke .env lalu isi. Jangan pernah commit .env.
# Urutan provider visual (dipisah koma), mis. fireworks,groq
VISION_BACKEND_CHAIN=
# Urutan provider teks (dipisah koma), mis. fireworks,groq
TEXT_BACKEND_CHAIN=
# Secret server Fireworks (demo)
FIREWORKS_API_KEY=
# Secret server Groq (demo)
GROQ_API_KEY=
# Key Fireworks khusus evaluasi/probe; jangan dipasang di HF Spaces
FIREWORKS_EVAL_API_KEY=
# Key Groq khusus evaluasi/probe; jangan dipasang di HF Spaces
GROQ_EVAL_API_KEY=
# Model ID visual Fireworks (dikunci setelah spike)
FIREWORKS_VISION_MODEL=
# Model ID teks Fireworks (dikunci setelah spike)
FIREWORKS_TEXT_MODEL=
# Model ID visual Groq
GROQ_VISION_MODEL=
# Model ID teks Groq
GROQ_TEXT_MODEL=
# Model penyusun draf caption evaluasi; harus berbeda dari FIREWORKS_TEXT_MODEL
DRAFT_MODEL=
# Batas token keluaran untuk panggilan teks, mis. 400
TEXT_MAX_TOKENS=
# Batas token keluaran untuk panggilan visual, mis. 500
VISION_MAX_TOKENS=
# URL Ollama untuk profil selfhosted, mis. http://ollama:11434
OLLAMA_URL=
# Model visual Ollama untuk profil selfhosted
OLLAMA_VISION_MODEL=
# Anggaran harian dalam USD, mis. 1.0
DAILY_BUDGET_USD=
# Origin CORS yang diizinkan (dipisah koma)
ALLOWED_ORIGINS=
# Batas laju per klien, mis. 10/minute;60/day
RATE_LIMIT=
# URL backend yang dipanggil frontend
NEXT_PUBLIC_API_URL=
# Mode frontend, mis. demo
NEXT_PUBLIC_MODE=
