{#- st-b: Surat Telegram bergaya formulir, monospace, bergaris. Gaya TTK/KMA. -#}
{% extends "base.html.j2" %}
{% block doc %}
{{ m.stamp(stamp, 'top') }}
<div class="kopblock">
  {{ m.logo(logo, 'small') }}
  <div class="kopcol">{% for x in kop %}{{ m.ln(x, 'kop') }}{% endfor %}</div>
</div>
<div class="titlebox">{{ m.ln(title, 'title') }}</div>
<div class="form {{ cls_pos }}">
  <div class="cell ruang">{{ m.row(kls) }}{{ m.row(drj) }}</div>
  <div class="cell nomorcell">{{ m.row(nomor) }}</div>
</div>
<div class="form-alamat">{% for x in alamat %}{{ m.row(x) }}{% endfor %}</div>
<div class="isi">{% for x in isi %}{{ m.para(x) }}{% endfor %}</div>
<div class="ttdblock">
  {% for x in tempat %}{{ m.row(x) }}{% endfor %}
  <div class="gap"></div>
  {% for x in ttd %}{{ m.ln(x) }}{% endfor %}
  <div class="gap2"></div>
  {% for x in ttd_nama %}{{ m.ln(x) }}{% endfor %}
</div>
{{ m.stamp(stamp_bottom, 'bottom') }}
{% endblock %}
