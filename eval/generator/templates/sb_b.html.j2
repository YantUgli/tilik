{#- sb-b: surat biasa satuan, sans. Logo kiri + kop tengah bergaris, label kapital, Kepada Yth. di bawah perihal. -#}
{% extends "base.html.j2" %}
{% block doc %}
{{ m.stamp(stamp, 'top') }}
<div class="kopblock">
  {{ m.logo(logo) }}
  <div class="kopcol">{% for x in kop %}{{ m.ln(x, 'kop') }}{% endfor %}</div>
</div>
<div class="rule"></div>
<div class="tgl">{{ m.ln(tempat_tgl) }}</div>
<div class="fields">{% for x in fields %}{{ m.row(x) }}{% endfor %}</div>
<div class="kepada">{% for x in kepada %}{{ m.ln(x) }}{% endfor %}</div>
<div class="body">{% for x in body %}{{ m.para(x) }}{% endfor %}</div>
<div class="ttdblock">
  {% for x in ttd %}{{ m.ln(x) }}{% endfor %}
  <div class="gap2"></div>
  {% for x in ttd_nama %}{{ m.ln(x) }}{% endfor %}
</div>
<div class="tembusan">{% for x in tembusan %}{{ m.ln(x) }}{% endfor %}</div>
{{ m.stamp(stamp_bottom, 'bottom') }}
{% endblock %}
