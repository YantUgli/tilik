{#- sb-a: surat biasa satuan, serif. Kop kiri dengan logo di atas, tanggal kanan, Kepada Yth. kanan. -#}
{% extends "base.html.j2" %}
{% block doc %}
{{ m.stamp(stamp, 'top') }}
<div class="kopcol">
  {{ m.logo(logo) }}
  {% for x in kop %}{{ m.ln(x, 'kop' ~ (' last' if loop.last else '')) }}{% endfor %}
</div>
<div class="tgl">{{ m.ln(tempat_tgl) }}</div>
<div class="meta">
  <div class="fields">{% for x in fields %}{{ m.row(x) }}{% endfor %}</div>
  <div class="kepada">{% for x in kepada %}{{ m.ln(x, 'indent' if loop.index == 3 else '') }}{% endfor %}</div>
</div>
<div class="body">{% for x in body %}{{ m.para(x) }}{% endfor %}</div>
<div class="ttdblock">
  {% for x in ttd %}{{ m.ln(x) }}{% endfor %}
  <div class="gap2"></div>
  {% for x in ttd_nama %}{{ m.ln(x, 'nama' if loop.first else '') }}{% endfor %}
</div>
<div class="tembusan">{% for x in tembusan %}{{ m.ln(x) }}{% endfor %}</div>
{{ m.stamp(stamp_bottom, 'bottom') }}
{% endblock %}
