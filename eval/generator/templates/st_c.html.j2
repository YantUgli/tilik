{#- st-c: Surat Telegram, sans. Ruang klasifikasi di pojok atas (kiri/kanan), logo di samping kop. Gaya TTK/KMA. -#}
{% extends "base.html.j2" %}
{% block doc %}
<div class="corner {{ cls_pos }}">
  <div class="box">{{ m.row(kls) }}{{ m.row(drj) }}</div>
</div>
{{ m.stamp(stamp, 'top') }}
<div class="kopblock">
  {{ m.logo(logo) }}
  <div class="kopcol">{% for x in kop %}{{ m.ln(x, 'kop') }}{% endfor %}</div>
</div>
<div class="rule"></div>
<div class="titlebox">{{ m.ln(title, 'title') }}{{ m.row(nomor, 'nomor') }}</div>
<div class="alamat">{% for x in alamat %}{{ m.row(x) }}{% endfor %}</div>
<div class="isi">{% for x in isi %}{{ m.para(x) }}{% endfor %}</div>
<div class="ttdblock">
  {% for x in tempat %}{{ m.row(x) }}{% endfor %}
  <div class="gap"></div>
  {% for x in ttd %}{{ m.ln(x) }}{% endfor %}
  <div class="gap2"></div>
  {% for x in ttd_nama %}{{ m.ln(x, 'nama' if loop.first else '') }}{% endfor %}
</div>
{{ m.stamp(stamp_bottom, 'bottom') }}
{% endblock %}
