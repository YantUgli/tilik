{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rule.schema.json",
  "title": "Rule",
  "description": "Satu aturan di services/api/rules/*.yaml (file YAML berisi daftar aturan). Regex dicompile dengan re.MULTILINE. Aturan tanpa minimal satu contoh positive dan satu negative ditolak saat dimuat.",
  "type": "object",
  "required": ["id", "layer", "category", "severity", "applies_to", "match", "message", "tests"],
  "properties": {
    "id":         { "type": "string", "pattern": "^R-(L3|L4|PII)-\\d{3}$", "description": "unik di seluruh rule set" },
    "layer":      { "enum": ["L3", "L4", "PII"] },
    "category":   { "$ref": "finding.schema.json#/properties/category" },
    "severity":   { "$ref": "finding.schema.json#/properties/severity" },
    "signal":     { "enum": ["specific", "generic"], "default": "generic",
                    "description": "dipakai FR-L3-05: tinggi hanya bila ada >= 1 sinyal specific dan >= 1 sinyal L3 lain; hanya bermakna untuk L3" },
    "applies_to": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["caption", "ocr"] } },
    "match": {
      "type": "object",
      "required": ["any_regex"],
      "properties": {
        "any_regex":        { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "require_context":  { "type": "array", "items": { "type": "string" },
                              "description": "minimal satu harus ada dalam ±3 baris (termasuk baris yang cocok)" },
        "negative_context": { "type": "array", "items": { "type": "string" },
                              "description": "bila ada di teks sumber yang sama, aturan tidak menyala" }
      }
    },
    "redact":      { "type": "string", "description": "mis. matched_words" },
    "message":     { "type": "string" },
    "explanation": { "type": "string" },
    "basis":       { "type": "string" },
    "tests": {
      "type": "object",
      "required": ["positive", "negative"],
      "properties": {
        "positive": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "negative": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    }
  }
}
